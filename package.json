{
  "name": "avaauto",
  "version": "1.4.0",
  "description": "Automated trading for AvaOptions with database monitoring and web interface - v1.1.8",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "node src/main.js",
    "start:dev": "node --watch src/main.js",
