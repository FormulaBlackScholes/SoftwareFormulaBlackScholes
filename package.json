  "dependencies": {
    "@playwright/test": "1.30.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "mysql2": "^3.15.2",
    "node-fetch": "^2.7.0",
    "sharp": "^0.33.5"
  }
}
